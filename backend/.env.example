# agent Environment Variables

# === Project ===
PROJECT_NAME=agent
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=Asia/Shanghai  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=agent
LOGFIRE_ENVIRONMENT=development


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# === AI Agent (pydantic_ai, openai) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.5
AI_AVAILABLE_MODELS=["gpt-5.5","gpt-5.4","gpt-5.4-mini"]
AI_TEMPERATURE=0.7
AI_THINKING_ENABLED=false
AI_THINKING_EFFORT=medium  # low, medium, high

# === Cloud speech transcription (server only) ===
ASR_ENABLED=false
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ASR_FALLBACK_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
# Per-attempt deadline; at most two attempts per recording.
ASR_TIMEOUT_SECONDS=25
# Per-account UTC-day audio budget. Each provider attempt reserves audio seconds.
ASR_DAILY_AUDIO_SECONDS=1800

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
REDIS_PASSWORD=change-me-in-production
# Flower monitoring credentials
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# Optional exact model-control policy (JSON). Unlisted model aliases expose no
# temperature/reasoning overrides. This is deployment policy, not auto-detection.
# AI_MODEL_CONTROLS={"gpt-5.5":["thinking_effort"],"gpt-4.1":["temperature","top_p"]}
# Per-model approved output budget (default: 8000, maximum: 32000).
# AI_MODEL_OUTPUT_LIMITS={"gpt-4.1":16000}

# Use postgres only after rebuilding and validating all searchable chunks.
RAG_SEARCH_BACKEND=legacy

# Conservative per-model context windows used by conversation input budgets (JSON).
# Unlisted models default to 32768; never put API keys here.
AI_MODEL_CONTEXT_LIMITS={}
